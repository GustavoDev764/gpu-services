[Unit]
Description=gpu-services LLM (vLLM + Gemma)
After=network-online.target

[Service]
Type=simple
User=gpu
WorkingDirectory=/opt/gpu-services/llm
EnvironmentFile=/etc/gpu-services.env
Environment=PYTHONUNBUFFERED=1
Environment=VLLM_NO_USAGE_STATS=1
ExecStart=/opt/gpu-services/llm/serve.sh
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
