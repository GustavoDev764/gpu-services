[Unit]
Description=gpu-services API
After=network-online.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=gpu
WorkingDirectory=/opt/gpu-services
EnvironmentFile=/etc/gpu-services.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
